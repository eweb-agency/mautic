<div class="loading-bar">
    {% trans %}mautic.core.loading{% endtrans %}
</div>

<div class="navbar-nocollapse">
    <!-- start: left nav -->
    <ul class="nav navbar-nav navbar-left">
        <li class="visible-xs">
            <a href="javascript: void(0);" data-toggle="sidebar" data-direction="ltr">
                <i class="ri-menu-line fs-16"></i>
            </a>
        </li>
        <!-- brand -->
         <li>
            <a class="pa-0" href="{{ path('mautic_dashboard_index') }}">
                <div class="brand-logo--desktop mautic-brand hidden-xs pl-md pr-lg">
                    {{ source('@MauticCore/Assets/images/logo--expanded.svg') }}
                </div>
                <div class="brand-logo--mobile mautic-brand visible-xs pr-sm">
                    {# Le VRAI logo (wordmark), pas le monogramme — demande
                       proprio 05/08. La règle générique du thème masque
                       `svg.mautic-logo-text` sous 768px (custom.less) : on la
                       neutralise UNIQUEMENT dans ce conteneur mobile. #}
                    {# Override MINIMAL : seul le display est neutralisé — le
                       logo hérite ainsi des dimensions officielles du
                       wordmark (mêmes règles que le desktop). #}
                    <style>
                        .brand-logo--mobile svg.mautic-logo-text { display: block; }
                        /* HEADER MOBILE EN UNE SEULE RANGÉE (défaut proprio
                           10/08 : le wordmark aux dimensions desktop poussait
                           la rangée d'icônes sur une 2e ligne — mesuré 98px
                           de header à 390px de large, 50px après ces règles,
                           303px utilisés : tient dès 360px).
                           - wordmark à hauteur d'icône ;
                           - l'aide « ? » se replie (ses raccourcis clavier
                             n'ont pas de sens au doigt) ;
                           - paddings serrés, avatar 28px sans chevron. */
                        @media (max-width: 767px) {
                            /* CENTRAGE VERTICAL EXPLICITE (défaut proprio
                               10/08 : le svg en display:block se calait en
                               HAUT de la case de 48px — top 1px au lieu de
                               14 — et selon l'écran débordait au-dessus du
                               bandeau, logo coupé). Mesuré après : centre
                               du logo = centre de la rangée. */
                            .brand-logo--mobile { display: flex; align-items: center; height: 48px; }
                            .brand-logo--mobile svg.mautic-logo-text { height: 20px; width: auto; }
                            .navbar-right li.quick-help { display: none; }
                            .navbar-nav.navbar-right > li > a { padding-left: 6px; padding-right: 6px; }
                            .sendly-avatar { width: 28px; height: 28px; }
                            .sendly-profile > a.dropdown-toggle i.ri-arrow-down-s-line { display: none; }
                        }
                    </style>
                    {{ source('@MauticCore/Assets/images/logo--expanded.svg') }}
                </div>
            </a>
            <!--/ brand -->
         </li>
        {% include '@MauticCore/Helper/button.html.twig' with {
            buttons: [
                {
                    label: 'mautic.core.search_everything',
                    tooltip_placement: 'right',
                    variant: 'ghost',
                    icon: 'ri-search-line ri-xl',
                    icon_only: true,
                    attributes: {
                    'type': 'button',
                    'data-toggle': 'modal',
                    'data-target': '#gsearchModal',
                    'class': 'search-button'
                }
                }
            ]
        } %}

    </ul>
    <!--/ end: left nav -->

    <!-- start: right nav -->
    <ul class="nav navbar-nav navbar-right">
        {{ render(controller('Mautic\\CoreBundle\\Controller\\DefaultController::notificationsAction')) }}
        {{ include('@MauticCore/Menu/quick_help.html.twig') }}
        {{ menuRender('admin') }}
        {# « Vos logiciels » entre l'engrenage et le profil — la position du
           motif de référence, constatée sur capture réelle du dashboard
           (dépouillement du 05/08). #}
        {{ include('@MauticCore/Menu/portal.html.twig') }}
        {{ include('@MauticCore/Menu/profile.html.twig') }}
    </ul>
    <div class="navbar-toolbar pull-right mt-15 mr-10">
    {{ buttonReset(constant('Mautic\\CoreBundle\\Twig\\Helper\\ButtonHelper::LOCATION_NAVBAR')) }}
    {{ buttonsRender() }}
    </div>

    <!--/ end: right nav -->
</div>
<!--/ end: navbar nocollapse -->
