<head>
    <meta charset="UTF-8" />
    <title>
        {% if headerTitle is defined and headerTitle is not empty %}
            {{ headerTitle|replace({'<': ' <'})|striptags|purify }} |
        {% endif %}
        {{ pageTitle|default('Sendly') }}
    </title>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <link rel="icon" type="image/x-icon" href="{{ getOverridableUrl('images/favicon.ico') }}?v=2" />
    <link rel="icon" sizes="192x192" href="{{ getOverridableUrl('images/favicon.ico') }}?v=2">
    <link rel="apple-touch-icon" href="{{ getOverridableUrl('images/apple-touch-icon.png') }}?v=2" />

    {{ outputSystemStylesheets() }}

    {% include('@MauticCore/Default/script.html.twig') %}

    {{ outputHeadDeclarations() }}
{# Câblage fork : le réglage « Angles arrondis » (Paramètres des thèmes)
   ne touchait que les contenus générés — on le propage au chrome admin
   en surchargeant les variables de rayon d'app.css (46 usages). #}
{% if getRoundedCorners('lg') > 0 %}
    <style>:root{--border-radius-sm: {{ getRoundedCorners('sm') }}px;--border-radius-md: {{ getRoundedCorners('md') }}px;--border-radius-lg: {{ getRoundedCorners('lg') }}px;}</style>
{% endif %}
</head>
