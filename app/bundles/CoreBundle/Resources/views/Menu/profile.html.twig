{% set inline = menuRender('profile') %}
<li class="dropdown sendly-profile">
    {# Identité VISIBLE dans la barre haute — avatar rond + nom + chevron,
       le motif du header de référence (capture proprio, 05/08) — au lieu de
       l'icône anonyme. L'avatar montre la photo (gravatar) quand elle
       existe, sinon les initiales sur pastille bleue. #}
    <style>
        /* GEOMETRIE VERROUILLEE (défaut proprio 07/08, validé en direct) : le
           thème impose flex-direction aux liens de menu → sans ces règles,
           avatar/nom/chevron s'empilent en COLONNE, le lien fait 180px, la
           rangée étire tout le bandeau (181px) et le titre + la barre de
           boutons passent SOUS le verre dépoli. Hauteur = 48px, comme les
           autres items — jamais plus. */
        .sendly-profile > a.dropdown-toggle { display: inline-flex !important; flex-flow: row nowrap !important; align-items: center !important; height: 48px !important; gap: 6px; border-radius: 24px !important; padding: 0 10px 0 8px !important; }
        /* Etat ouvert/focus : le style du theme (outline 2px + fond gris,
           angles droits) va aux icones carrees, pas a une pastille large —
           il dessinait un grand rectangle brut (defaut proprio 07/08).
           Remplace par la pilule arrondie au voile bleu. */
        .sendly-profile.open > a.dropdown-toggle,
        .sendly-profile > a.dropdown-toggle:focus,
        .sendly-profile > a.dropdown-toggle:focus-visible { outline-color: transparent !important; background: rgba(0,79,255,.07) !important; }
        .sendly-profile > a.dropdown-toggle i.ri-arrow-down-s-line { height: auto !important; line-height: 1 !important; }
        .sendly-avatar {
            position: relative; width: 30px; height: 30px; border-radius: 50%;
            background: #004FFF; color: #fff; display: inline-flex; flex: none;
            align-items: center; justify-content: center; font-size: 12px;
            font-weight: 700; overflow: hidden; letter-spacing: .02em;
        }
        .sendly-avatar img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
        /* Image chargée = fond BLANC + initiales effacées : le logo gravatar
           (disque sur fond transparent) laissait sinon transparaître le
           cercle bleu du repli en anneau (« double pastille », défaut
           proprio 07/08). */
        .sendly-avatar.has-img { background: #fff; color: transparent; }
        .sendly-profile-name { font-weight: 600; max-width: 160px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        /* Sous 1400px le nom disparait : la rangee d'icones du header ne doit
           JAMAIS deborder sur une 2e ligne — elle recouvrirait les boutons de
           la page sous le verre depoli du theme (preuve e2e du 07/08 :
           « element click intercepted » sur Save, l'UL navbar-right recevait
           le clic). Avatar seul = meme encombrement qu'une icone. */
        @media (max-width: 1399px) { .sendly-profile-name { display: none; } }
    </style>
    <a class="dropdown-toggle" data-toggle="dropdown" href="#" aria-label={{ 'mautic.lead.lead.social.profile'|trans }}>
        <span class="sendly-avatar">
            {{ app.getUser().getName()|split(' ')|map(w => w|slice(0, 1))|join|upper|slice(0, 2) }}
            <img loading="lazy" decoding="async" referrerpolicy="no-referrer" onload="this.parentNode.classList.add('has-img')" onerror="this.classList.add('hide')" src="{{ gravatarGetImage(app.getUser().getEmail()) }}" alt="">
        </span>
        <span class="sendly-profile-name hidden-xs">{{ app.getUser().getName() }}</span>
        <i class="ri-arrow-down-s-line"></i>
    </a>
    <ul class="dropdown-menu dropdown-menu-right">
        {# Le bloc identité (photo + nom) qui vivait ici a été DÉPLACÉ sur le
           bouton lui-même (directive proprio 07/08, motif Webmecanik) : il ne
           doit pas apparaître aux deux endroits. #}
        <li>
            <a href="{{ path('mautic_user_account') }}" data-toggle="ajax">
                <i class="ri-user-smile-line ri-lg"></i><span>{% trans %}mautic.user.account.settings{% endtrans %}</span>
            </a>
        </li>

        {% if securityIsGranted('user:users:create') %}
        <li>
            <a href="{{ path('mautic_user_action', {objectAction: 'new'}) }}">
                <i class="ri-team-line"></i>
                <span>{{ 'mautic.user.profile.invite'|trans }}</span>
            </a>
        </li>
        {% endif %}

        <li>
            <a href="{{ path('mautic_user_logout') }}">
                <i class="ri-logout-circle-r-line ri-lg"></i><span>{% trans %}mautic.user.auth.logout{% endtrans %}</span>
            </a>
        </li>

        {% if inline %}
        <li role="separator" class="divider"></li>
        {{ inline }}
        {% endif %}
    </ul>
</li>