{% set inline = menuRender('profile') %}
<li class="dropdown sendly-profile">
    {# Identité VISIBLE dans la barre haute — avatar rond + nom + chevron,
       le motif du header de référence (capture proprio, 05/08) — au lieu de
       l'icône anonyme. L'avatar montre la photo (gravatar) quand elle
       existe, sinon les initiales sur pastille bleue. #}
    <style>
        .sendly-profile > a.dropdown-toggle { display: inline-flex; align-items: center; gap: 8px; }
        .sendly-avatar {
            position: relative; width: 30px; height: 30px; border-radius: 50%;
            background: #004FFF; color: #fff; display: inline-flex; flex: none;
            align-items: center; justify-content: center; font-size: 12px;
            font-weight: 700; overflow: hidden; letter-spacing: .02em;
        }
        .sendly-avatar img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
        .sendly-profile-name { font-weight: 600; max-width: 160px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    </style>
    <a class="dropdown-toggle" data-toggle="dropdown" href="#" aria-label={{ 'mautic.lead.lead.social.profile'|trans }}>
        <span class="sendly-avatar">
            {{ app.getUser().getName()|split(' ')|map(w => w|slice(0, 1))|join|upper|slice(0, 2) }}
            <img onerror="this.classList.add('hide')" src="{{ gravatarGetImage(app.getUser().getEmail()) }}" alt="">
        </span>
        <span class="sendly-profile-name hidden-xs">{{ app.getUser().getName() }}</span>
        <i class="ri-arrow-down-s-line"></i>
    </a>
    <ul class="dropdown-menu dropdown-menu-right">
        <li>
            <div class="dropdown-menu-user row-no-gutters fw-nowrap ma-md">
                <span class="img-wrapper"><img onerror="this.classList.add('hide')" src="{{ gravatarGetImage(app.getUser().getEmail()) }}"></span>
                <span class="d-flex fd-column jc-center ml-sm info">
                    <span class="text text-nowrap fw-sb">{{ app.getUser().getName() }}</span>
                    {% if app.getUser().getPosition() %}
                        <span class="text-nowrap small">{{ app.getUser().getPosition() }}</span>
                    {% endif %}
                </span>
            </div>
        </li>
        
        <li>
            <a href="{{ path('mautic_user_account') }}" data-toggle="ajax">
                <i class="ri-user-smile-line ri-lg"></i><span>{% trans %}mautic.user.account.settings{% endtrans %}</span>
            </a>
        </li>

        {% if securityIsGranted('user:users:create') %}
        <li>
            <a href="{{ path('mautic_user_action', {objectAction: 'new'}) }}">
                <i class="ri-team-line"></i>
                <span>{{ 'mautic.user.profile.invite'|trans }}</span>
            </a>
        </li>
        {% endif %}

        <li>
            <a href="{{ path('mautic_user_logout') }}">
                <i class="ri-logout-circle-r-line ri-lg"></i><span>{% trans %}mautic.user.auth.logout{% endtrans %}</span>
            </a>
        </li>

        {% if inline %}
        <li role="separator" class="divider"></li>
        {{ inline }}
        {% endif %}
    </ul>
</li>