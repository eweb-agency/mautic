{#
  Tuile « Temps gagné avec l'assistant » — v4, prototypée en direct dans
  la tuile réelle (28/08). Le retour proprio qui l'a façonnée : « en tant
  qu'utilisateur, je ne comprends pas à quoi sert ce widget » — la v4
  RACONTE au lieu d'afficher : une phrase (« L'assistant vous a fait
  gagner »), le chiffre en héros, des RÉALISATIONS comptées (« ✓ 3
  e-mails rédigés ») au lieu de barres abstraites, et l'explication en
  français en pied. La composition possède la hauteur du widget.
#}
{% macro duree(seconds) -%}
  {%- set h = (seconds // 3600) -%}
  {%- set m = ((seconds % 3600) / 60)|round -%}
  {%- if h > 0 -%}{{ h }} h{% if m > 0 %} {{ '%02d'|format(m) }}{% endif %}{%- else -%}{{ m }} min{%- endif -%}
{%- endmacro %}

{% if not actif %}
  <div style="padding:18px 8px"><p style="color:#8b95a7;font-size:13px;margin:0">{{ 'mautic.eweb.ai.temps.inactif'|trans }}</p></div>
{% elseif secondsMonth < 60 and secondsTotal < 60 %}
  <div style="padding:18px 8px"><p style="color:#8b95a7;font-size:13px;margin:0">{{ 'mautic.eweb.ai.temps.vide'|trans }}</p></div>
{% else %}
  <div style="display:flex;flex-direction:column;flex:1;min-height:0;padding:2px 8px">
    <div style="flex:1;display:flex;flex-direction:column;justify-content:center;min-height:0">
      <div style="display:flex;align-items:center;gap:9px;margin-bottom:10px">
        <span style="width:26px;height:26px;border-radius:8px;background:radial-gradient(circle at 50% 25%, #0a52d8, #05215c);display:inline-flex;align-items:center;justify-content:center;color:#fff;font-size:12px">✦</span>
        <span style="font-size:13px;color:#5b6472">{{ 'mautic.eweb.ai.temps.phrase'|trans }}</span>
      </div>
      <div style="font-size:52px;font-weight:700;letter-spacing:-.025em;color:#001248;line-height:1;font-variant-numeric:tabular-nums">{{ _self.duree(secondsMonth) }}</div>
      <div style="font-size:12.5px;color:#8b95a7;margin-top:7px">{{ 'mautic.eweb.ai.temps.ce.mois'|trans }} · {{ _self.duree(secondsTotal) }} {{ 'mautic.eweb.ai.temps.depuis.activation'|trans }}</div>
    </div>
    {% if gestes|length %}
      <div style="display:flex;flex-direction:column;gap:7px;padding-top:12px;border-top:1px solid #eef1f6">
        {% for g in gestes|slice(0, 4) %}
          <div style="display:flex;justify-content:space-between;gap:12px;font-size:12.5px;color:#374151">
            <span style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><span style="color:#0a7d43;font-weight:700">✓</span> {{ g.cle|trans({'%nb%': g.nb}) }}</span>
            <span style="font-variant-numeric:tabular-nums;font-weight:600;flex-shrink:0">{{ _self.duree(g.seconds) }}</span>
          </div>
        {% endfor %}
        {% if gestes|length > 4 %}
          {% set reste = 0 %}
          {% for g in gestes|slice(4) %}{% set reste = reste + g.seconds %}{% endfor %}
          <div style="font-size:11.5px;color:#8b95a7">+ {{ gestes|length - 4 }} {{ 'mautic.eweb.ai.temps.autres'|trans }} · {{ _self.duree(reste) }}</div>
        {% endif %}
        <div style="font-size:11px;color:#aab3c2;margin-top:3px">{{ 'mautic.eweb.ai.temps.explication'|trans }}</div>
      </div>
    {% endif %}
  </div>
{% endif %}
