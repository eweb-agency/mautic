{#
  Tuile « Temps rendu par l'assistant » (maquette validée 28/08, n° 2) :
  chiffre du mois + total, détail par geste en barres, ligne d'honnêteté.
  Le formatage h/min vit ici (macro) — le subscriber ne parle qu'en secondes.
#}
{% macro duree(seconds) -%}
  {%- set h = (seconds // 3600) -%}
  {%- set m = ((seconds % 3600) / 60)|round -%}
  {%- if h > 0 -%}{{ h }} h{% if m > 0 %} {{ '%02d'|format(m) }}{% endif %}{%- else -%}{{ m }} min{%- endif -%}
{%- endmacro %}

<div style="padding:16px 20px">
  {% if not actif %}
    <p style="color:#8b95a7;font-size:13px;margin:0">{{ 'mautic.eweb.ai.temps.inactif'|trans }}</p>
  {% elseif secondsMonth < 60 and secondsTotal < 60 %}
    <p style="color:#8b95a7;font-size:13px;margin:0">{{ 'mautic.eweb.ai.temps.vide'|trans }}</p>
  {% else %}
    <div style="font-size:32px;font-weight:700;letter-spacing:-.02em;color:#001248;line-height:1.15;font-variant-numeric:tabular-nums">
      {{ _self.duree(secondsMonth) }}
      <small style="font-size:13px;font-weight:500;color:#8b95a7;letter-spacing:0">
        {{ 'mautic.eweb.ai.temps.ce.mois'|trans }} · {{ _self.duree(secondsTotal) }} {{ 'mautic.eweb.ai.temps.au.total'|trans }}
      </small>
    </div>
    {% if gestes|length %}
      <div style="display:flex;flex-direction:column;gap:7px;margin-top:14px">
        {% for g in gestes %}
          <div style="display:flex;align-items:center;gap:10px;font-size:12.5px;color:#4b5563">
            <span style="width:118px;flex-shrink:0">{{ g.cle|trans }}</span>
            <span style="flex:1;height:7px;border-radius:999px;background:#eef1f6;overflow:hidden"><i style="display:block;height:100%;width:{{ g.pct }}%;border-radius:999px;background:linear-gradient(90deg,#2E6BFF,#004FFF)"></i></span>
            <span style="width:58px;text-align:right;font-variant-numeric:tabular-nums;color:#374151;font-weight:600;flex-shrink:0">{{ _self.duree(g.seconds) }}</span>
          </div>
        {% endfor %}
      </div>
    {% endif %}
    <p style="font-size:11.5px;color:#8b95a7;margin:12px 0 0">{{ 'mautic.eweb.ai.temps.honnete'|trans }}</p>
  {% endif %}
</div>
