{#
  Tuile « Temps rendu par l'assistant » — composition REVUE (retour proprio
  28/08 : le premier gabarit s'étalait sur toute la largeur, barre unique
  absurde, chiffre perdu dans le vide). Fidèle à la maquette validée :
  DEUX colonnes — le chiffre à gauche (étincelle, mois en grand, total et
  honnêteté dessous), les barres à droite dans une largeur CONTENUE.
#}
{% macro duree(seconds) -%}
  {%- set h = (seconds // 3600) -%}
  {%- set m = ((seconds % 3600) / 60)|round -%}
  {%- if h > 0 -%}{{ h }} h{% if m > 0 %} {{ '%02d'|format(m) }}{% endif %}{%- else -%}{{ m }} min{%- endif -%}
{%- endmacro %}

{% if not actif %}
  <div style="padding:26px"><p style="color:#8b95a7;font-size:13px;margin:0">{{ 'mautic.eweb.ai.temps.inactif'|trans }}</p></div>
{% elseif secondsMonth < 60 and secondsTotal < 60 %}
  <div style="padding:26px"><p style="color:#8b95a7;font-size:13px;margin:0">{{ 'mautic.eweb.ai.temps.vide'|trans }}</p></div>
{% else %}
  <div style="display:flex;align-items:center;gap:44px;flex-wrap:wrap;padding:24px 30px">
    <div style="flex-shrink:0">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px">
        <span style="width:30px;height:30px;border-radius:9px;background:radial-gradient(circle at 50% 25%, #0a52d8, #05215c);display:inline-flex;align-items:center;justify-content:center;color:#fff;font-size:14px">✦</span>
        <span style="font-size:12px;font-weight:600;color:#5b6472;letter-spacing:.04em;text-transform:uppercase">{{ 'mautic.eweb.ai.temps.ce.mois'|trans }}</span>
      </div>
      <div style="font-size:42px;font-weight:700;letter-spacing:-.02em;color:#001248;line-height:1;font-variant-numeric:tabular-nums">{{ _self.duree(secondsMonth) }}</div>
      <div style="font-size:12.5px;color:#8b95a7;margin-top:8px">{{ _self.duree(secondsTotal) }} {{ 'mautic.eweb.ai.temps.au.total'|trans }}</div>
      <div style="font-size:11px;color:#aab3c2;margin-top:14px;max-width:230px;line-height:1.5">{{ 'mautic.eweb.ai.temps.honnete'|trans }}</div>
    </div>
    {% if gestes|length %}
      <div style="flex:1;min-width:250px;max-width:470px;display:flex;flex-direction:column;gap:9px">
        {% for g in gestes %}
          <div style="display:flex;align-items:center;gap:12px;font-size:12.5px;color:#4b5563">
            <span style="width:118px;flex-shrink:0">{{ g.cle|trans }}</span>
            <span style="flex:1;height:8px;border-radius:999px;background:#eef1f6;overflow:hidden"><i style="display:block;height:100%;width:{{ g.pct }}%;border-radius:999px;background:linear-gradient(90deg,#2E6BFF,#004FFF)"></i></span>
            <span style="width:56px;text-align:right;font-variant-numeric:tabular-nums;color:#374151;font-weight:600;flex-shrink:0">{{ _self.duree(g.seconds) }}</span>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
{% endif %}
