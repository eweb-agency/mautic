{#
  Tuile « Temps gagné avec l'assistant » — design « rythme » (variante A
  du board du 28/08), choisi par le proprio après prototypage en direct
  dans la tuile réelle : en-tête symétrique (étincelle + phrase à gauche,
  pilule du mois à droite), le TOTAL en héros aligné sur l'axe du texte
  de la phrase (retrait 33px = badge 24px + espace 9px), et les
  8 dernières semaines en barres pleine largeur, la semaine en cours en
  vedette avec sa valeur. Le retrait -14px resserre l'écart sous
  l'en-tête natif de la carte (validé à l'écran).
#}
{% macro duree(seconds) -%}
  {%- set h = (seconds // 3600) -%}
  {%- set m = ((seconds % 3600) / 60)|round -%}
  {%- if h > 0 -%}{{ h }} h{% if m > 0 %} {{ '%02d'|format(m) }}{% endif %}{%- else -%}{{ m }} min{%- endif -%}
{%- endmacro %}

{% if not actif %}
  <div style="padding:18px 8px"><p style="color:#8b95a7;font-size:13px;margin:0">{{ 'mautic.eweb.ai.temps.inactif'|trans }}</p></div>
{% elseif secondsTotal < 60 %}
  <div style="padding:18px 8px"><p style="color:#8b95a7;font-size:13px;margin:0">{{ 'mautic.eweb.ai.temps.vide'|trans }}</p></div>
{% else %}
  {% set hmax = semaines|sort|last %}
  <div style="display:flex;flex-direction:column;flex:1;min-height:0;padding:0 8px 4px;margin-top:-14px">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px">
      <span style="display:inline-flex;align-items:center;gap:9px;min-width:0">
        <span style="width:24px;height:24px;border-radius:7px;background:radial-gradient(circle at 50% 22%, #0a52d8, #05215c);display:inline-flex;align-items:center;justify-content:center;color:#fff;font-size:11px;flex-shrink:0">✦</span>
        <span style="font-size:13px;color:#5b6472">{{ 'mautic.eweb.ai.temps.phrase'|trans }}</span>
      </span>
      {% if secondsMonth >= 60 %}
        <span style="display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:4px 11px;background:#DFEAFF;color:#001248;font-size:11.5px;font-weight:600;flex-shrink:0"><span style="width:6px;height:6px;border-radius:50%;background:#004FFF"></span>{{ _self.duree(secondsMonth) }} {{ 'mautic.eweb.ai.temps.ce.mois'|trans }}</span>
      {% endif %}
    </div>
    <div style="margin-top:12px;padding-left:33px">
      <span style="font-size:44px;font-weight:700;letter-spacing:-.025em;line-height:1;color:#001248;font-variant-numeric:tabular-nums">{{ _self.duree(secondsTotal) }}</span>
    </div>
    <div style="flex:1;min-height:14px"></div>
    <div style="display:flex;align-items:flex-end;justify-content:space-between;height:78px;border-bottom:1px solid #e4e8ef;padding-bottom:1px">
      {% for v in semaines %}
        {% if v >= 60 %}
          <div style="width:24px;border-radius:6px 6px 3px 3px;position:relative;height:{{ [10, (72 * v / hmax)|round]|max }}px;background:{{ loop.last ? 'linear-gradient(180deg,#2E6BFF,#004FFF)' : '#9db9ff' }}">
            {% if loop.last %}<span style="position:absolute;top:-20px;left:50%;transform:translateX(-50%);font-size:10.5px;font-weight:700;color:#004FFF;white-space:nowrap">{{ _self.duree(v) }}</span>{% endif %}
          </div>
        {% else %}
          <div style="width:24px;border-radius:6px 6px 3px 3px;height:6px;background:#E9EEF7"></div>
        {% endif %}
      {% endfor %}
    </div>
    <div style="font-size:10.5px;color:#8b95a7;margin-top:7px;display:flex;justify-content:space-between">
      <span>{{ 'mautic.eweb.ai.temps.huit.semaines'|trans }}</span>
      <span>{{ 'mautic.eweb.ai.temps.estimation'|trans }}</span>
    </div>
  </div>
{% endif %}
